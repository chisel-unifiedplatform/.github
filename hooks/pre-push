#!/bin/sh
# Stops pushes straight to shared branches. Open a pull request instead.
# Bypass once (e.g. an emergency the team agreed on): ALLOW_PUSH=1 git push ...
PROTECTED="${PROTECTED_BRANCHES:-main dev prod master}"
[ "$ALLOW_PUSH" = "1" ] && exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  for p in $PROTECTED; do
    if [ "$branch" = "$p" ]; then
      echo "✋ Push to '$p' blocked. Push your branch and open a pull request:" >&2
      echo "   git push -u origin HEAD:your-branch-name && gh pr create --base $p" >&2
      echo "   (Direct pushes to $p are also refused by the deploy guard.)" >&2
      exit 1
    fi
  done
done
exit 0
